# Ignore development files (keep package.json so Vercel can run build)
node_modules/
.git/
.github/
.gitignore
.vercelignore
yarn.lock
npm-debug.log
yarn-error.log

# Ignore local configuration files that shouldn't be deployed
.env
.env.local
.env.development
.env.test
.env.production

# Ignore IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore temporary files
*.tmp
*.temp
.cache/
dist/
build/